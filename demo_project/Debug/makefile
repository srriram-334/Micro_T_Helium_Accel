Micro_T_Helium_Accel.siz \


# All Target
all: Micro_T_Helium_Accel.elf secondary-outputs

# Tool invocations
Micro_T_Helium_Accel.elf: $(OBJS) $(USER_OBJS) $(LINKER_SCRIPT)
	$(file > Micro_T_Helium_Accel.elf.in,-mthumb -mfloat-abi=hard -mcpu=cortex-m85+nopacbti -O2 -fmessage-length=0 -fsigned-char -ffunction-sections -fdata-sections -fno-strict-aliasing -Wunused -Wuninitialized -Wall -Wextra -Wmissing-declarations -Wconversion -Wpointer-arith -Wshadow -Wlogical-op -Waggregate-return -Wfloat-equal -g -T "fsp.ld" -T "C:\\Users\\skull\\e2_studio\\workspace\\Micro_T_Helium_Accel\\mtk3_bsp2\\etc\\linker\\mtkernel.ld" -Xlinker --gc-sections -L "C:\\Users\\skull\\e2_studio\\workspace\\Micro_T_Helium_Accel/script" -Wl,-Map,"Micro_T_Helium_Accel.map" --specs=nano.specs -o "Micro_T_Helium_Accel.elf" -Wl,--start-group $(OBJS) $(USER_OBJS) $(LIBS) -Wl,--end-group)
	@echo Building target: $@ && arm-none-eabi-gcc @"Micro_T_Helium_Accel.elf.in"
Micro_T_Helium_Accel.srec: Micro_T_Helium_Accel.elf
	arm-none-eabi-objcopy -O srec "Micro_T_Helium_Accel.elf"  "Micro_T_Helium_Accel.srec"
Micro_T_Helium_Accel.siz: Micro_T_Helium_Accel.elf
	arm-none-eabi-size --format=berkeley "Micro_T_Helium_Accel.elf"
# Other Targets
